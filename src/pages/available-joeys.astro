---
import BaseLayout from '../layouts/BaseLayout.astro';
import CallCTA from '../components/CallCTA.astro';
import { site } from '../data/site.js';
import { joeys } from '../data/joeys.js';

const title = 'Sugar Gliders for Sale Philippines: Available Joeys';
const description =
  'See the hand-raised sugar glider joeys available now, by colour and temperament. Full DENR paperwork on every purchase. Reserve your joey today.';

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Available Joeys', path: '/available-joeys' },
];

const badgeClass = (status) => {
  if (status === 'Reserved') return 'joey__badge--reserved';
  if (status === 'Bonded Pair') return 'joey__badge--pair';
  return 'joey__badge--available';
};
---

<BaseLayout title={title} description={description} schema={['BreadcrumbList']} breadcrumbs={breadcrumbs}>
  <section class="section">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><span aria-current="page">Available Joeys</span></li>
        </ol>
      </nav>

      <h1>Sugar Gliders for Sale in the Philippines: Available Joeys</h1>
      <p class="lead">
        These are the joeys ready to be matched right now. Each one has been
        hand-raised and handled daily, so what you read in the temperament notes is
        what you will meet. When a joey is reserved, we mark it, and we do not
        double-promise an animal. If the one you want is already spoken for, tell us
        the temperament you are after and we will hold the next that fits.
      </p>

      <CallCTA bare />
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <h2 class="mt-0">How to read these cards</h2>
      <div class="grid">
        <div class="card">
          <h3>Colour / morph</h3>
          <p>From classic grey through to mosaic, leucistic, and platinum. Colour changes the look, not the personality. If you are choosing on appearance, read <a href="/care-guide/sugar-glider-colours-morphs">Colours &amp; Morphs</a> first.</p>
        </div>
        <div class="card">
          <h3>Out-of-pouch date</h3>
          <p>A joey goes home only once it is fully weaned and confident with people, never before. The date tells you how settled it already is.</p>
        </div>
        <div class="card">
          <h3>Temperament tag</h3>
          <p>Calm, curious, busy, or velcro (the ones that never want to leave your pocket). This is the field most buyers ignore and most regret ignoring.</p>
        </div>
        <div class="card">
          <h3>Status</h3>
          <p>Available, Reserved, or part of a Bonded Pair. We place gliders in pairs unless your home already has one, because a lone glider often does not thrive.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="mt-0">The joeys</h2>
      <div class="joey-grid">
        {
          joeys.map((j) => (
            <article class="joey">
              <div class="joey__media">
                {j.image ? (
                  <img src={j.image} alt={`${j.morph} sugar glider joey, ${j.name}, available in the Philippines`} loading="lazy" />
                ) : (
                  <svg width="64" height="64" viewBox="0 0 64 64" fill="none" aria-hidden="true">
                    <path d="M32 16c-7 0-12 4-16 11-2 3-5 5-8 6 4 3 9 4 14 3 3 5 6 8 10 8s7-3 10-8c5 1 10 0 14-3-3-1-6-3-8-6-4-7-9-11-16-11Z" fill="#cfc3a8"/>
                    <ellipse cx="32" cy="33" rx="6.5" ry="10" fill="#b6a98f"/>
                  </svg>
                )}
                <span class={`joey__badge ${badgeClass(j.status)}`}>{j.status}</span>
              </div>
              <div class="joey__body">
                <h3 class="joey__name">{j.name}</h3>
                <ul class="joey__meta">
                  <li>{j.morph}</li>
                  <li>{j.sex}</li>
                  <li>OOP {j.oop}</li>
                  <li>{j.temperament}</li>
                </ul>
                {j.note && <p class="joey__note">{j.note}</p>}
                {j.priceFrom && <p class="muted" style="margin:0;font-size:0.9rem;">from {j.priceFrom}</p>}
                <div class="joey__cta">
                  {j.status === 'Reserved' ? (
                    <a class="btn btn--ghost btn--sm" href={site.phoneHref}>Ask for the next like this</a>
                  ) : (
                    <a class="btn btn--primary btn--sm" href={site.phoneHref}>Call to Reserve</a>
                  )}
                </div>
              </div>
            </article>
          ))
        }
      </div>
      <p class="muted" style="margin-top:1.5rem;font-size:0.92rem;">
        Cards show a price-from label where relevant. The exact price for the joey
        you want, including morph and whether you take a single or a bonded pair, is
        confirmed by phone.
      </p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container" style="max-width:46rem;">
      <h2 class="mt-0">Pricing, plainly</h2>
      <p>
        Our hand-raised joeys start at ₱13,000, with the full DENR paperwork
        included in that price. A rarer colour or a bonded pair sits above it. Call
        us and we will give you the exact figure for the joey you are looking at,
        along with what the documentation covers and how in-person delivery works.
      </p>
      <h2>Ready, or nearly ready?</h2>
      <p>
        If a joey here already feels like yours, call and we will confirm it for
        you. If you are still deciding between two, tell us about your home and we
        will tell you honestly which one suits it better.
      </p>
      <CallCTA />
    </div>
  </section>
</BaseLayout>
