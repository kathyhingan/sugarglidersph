---
// Simple inline logo mark: a stylised gliding sugar glider silhouette.
const { class: className = 'brand__mark' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 64 64"
  fill="none"
  role="img"
  aria-label="Sugar Gliders Philippines logo"
  xmlns="http://www.w3.org/2000/svg"
>
  <circle cx="32" cy="32" r="32" fill="#3c6b54"></circle>
  <!-- gliding membrane spread -->
  <path
    d="M32 16c-7 0-12 4-16 11-2 3-5 5-8 6 4 3 9 4 14 3 3 5 6 8 10 8s7-3 10-8c5 1 10 0 14-3-3-1-6-3-8-6-4-7-9-11-16-11Z"
    fill="#bfe0cf"
  ></path>
  <!-- body -->
  <ellipse cx="32" cy="33" rx="6.5" ry="10" fill="#2f5642"></ellipse>
  <!-- dorsal stripe -->
  <rect x="30.7" y="24" width="2.6" height="18" rx="1.3" fill="#1f3a2c"></rect>
  <!-- eyes -->
  <circle cx="29" cy="27" r="1.7" fill="#1f3a2c"></circle>
  <circle cx="35" cy="27" r="1.7" fill="#1f3a2c"></circle>
</svg>
