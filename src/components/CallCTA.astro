---
import { site, ctaMicrocopy } from '../data/site.js';
// Reusable single call-to-action. `bare` removes the card chrome.
const { bare = false, label = 'Call to Reserve' } = Astro.props;
---

<div class={`cta-block${bare ? ' cta-block--bare' : ''}`}>
  <a class="btn btn--primary" href={site.phoneHref}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1Z"></path>
    </svg>
    <span>{label} → {site.phoneDisplay}</span>
  </a>
  <p class="cta-block__micro">{ctaMicrocopy}</p>
</div>
